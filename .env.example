# Frontend config. Copy to .env.local (gitignored).
#
# Local stack: run `npx supabase start`, then copy "API_URL" and "ANON_KEY"
# from `npx supabase status`.
# Hosted project: Supabase dashboard -> Project Settings -> API.
#
# Only VITE_-prefixed values reach the browser, so only public values belong
# here: never put a service-role key, OpenRouter key or webhook secret in a
# VITE_ variable.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
